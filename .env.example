# Secrets stay in private 0600 files. See docs/comment-bridge.md.
SHADOWBRAIN_COMMENT_BRIDGE_DB=comment-bridge.db
SHADOWBRAIN_COMMENT_POLL_INTERVAL=1m
SHADOWBRAIN_COMMENT_WORK_INTERVAL=1s

SHADOWBRAIN_FEISHU_APP_ID=
SHADOWBRAIN_FEISHU_APP_SECRET_FILE=./secrets/feishu-app-secret
SHADOWBRAIN_FEISHU_CHAT_ID=
SHADOWBRAIN_FEISHU_ALLOWED_OPEN_IDS=
# Enable only to authorize all human members of the exact configured groups.
SHADOWBRAIN_FEISHU_ALLOW_ALL_GROUP_MEMBERS=false

SHADOWBRAIN_YOUTUBE_ENABLED=false
SHADOWBRAIN_YOUTUBE_CHANNEL_ID=
SHADOWBRAIN_YOUTUBE_ACCOUNT_ID=
SHADOWBRAIN_YOUTUBE_CLIENT_FILE=./secrets/youtube-client.json
SHADOWBRAIN_YOUTUBE_TOKEN_FILE=./secrets/youtube-token.json
SHADOWBRAIN_YOUTUBE_MAX_PAGES=2
# Optional: separate group for YouTube application-bot notifications and replies.
# Mutually exclusive with SHADOWBRAIN_YOUTUBE_FEISHU_WEBHOOK_FILE.
SHADOWBRAIN_YOUTUBE_FEISHU_CHAT_ID=
# Optional: private 0600 file containing a one-way Feishu custom bot URL.
# Empty keeps YouTube on the existing application bot.
SHADOWBRAIN_YOUTUBE_FEISHU_WEBHOOK_FILE=

# Unofficial Bilibili API; keep both gates disabled until explicitly enabled.
SHADOWBRAIN_BILIBILI_EXPERIMENTAL_ENABLED=false
# Required value when enabled: I_UNDERSTAND_BILIBILI_WEB_API_ACCOUNT_RISK
SHADOWBRAIN_BILIBILI_EXPERIMENTAL_RISK_ACK=
SHADOWBRAIN_BILIBILI_CREDENTIAL_FILE=./bilibili-auth/credential.json
SHADOWBRAIN_BILIBILI_ACCOUNT_ID=
SHADOWBRAIN_BILIBILI_MAX_SUB_REPLY_PAGES=10

# Optional: existing absolute 0700 directory shared with the local Codex worker.
# Empty disables danmaku monitoring; fixed cadence 10m, maximum 100 per poll.
SHADOWBRAIN_DANMAKU_QUEUE_DIR=
